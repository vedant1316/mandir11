# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ──────────────────────────────────────────────────────────────────
# Mandir 11 Application Database (PostgreSQL with asyncpg):
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mandir11

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=168

# ─── WebSocket (Phase 2 — cricket live scoring) ────────────────────────────────
WEBSOCKET_PATH=/ws/match

# ─── Admin Bootstrap ───────────────────────────────────────────────────────────
# First admin account is created by providing this invite code during registration.
ADMIN_INVITE_CODE=set-a-secure-invite-code-here
